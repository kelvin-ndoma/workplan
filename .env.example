
MONGODB_URI=

AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Production: https://your-workplan-domain.com
# Generate AUTH_SECRET with: openssl rand -base64 32

# Email via Resend — https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM="WorkPlan <connect@theburnsbrothers.com>"

# Required in production. Vercel Cron sends this as Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Optional. Defaults to theburnsbrothers.com
# ALLOWED_EMAIL_DOMAIN=theburnsbrothers.com
